[Unit]
Description=Refresh CryptoBot viewer backtest snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cryptobot
WorkingDirectory=/home/cryptobot/cryptoBot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/cryptobot/cryptoBot/.venv/bin/python /home/cryptobot/cryptoBot/refresh_viewer_backtest.py
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/cryptobot/cryptoBot/data
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CPUQuota=25%
